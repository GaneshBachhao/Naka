# .env.example
# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=naka
POSTGRES_PASSWORD=naka
POSTGRES_DB=naka
DATABASE_URL=postgresql+asyncpg://naka:naka@localhost:5432/naka

# --- Redis / ARQ ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
ANTHROPIC_API_KEY=

# --- Auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# --- App ---
ENVIRONMENT=development
DEFAULT_LOCALE=mr
RESPONSE_LINK_BASE_URL=https://naka.in/r
# JSON array of allowed browser origins for the ops console (T8) - it's a
# separate client-rendered origin hitting the API directly.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
