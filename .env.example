# .env.example
# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=naka
POSTGRES_PASSWORD=naka
POSTGRES_DB=naka
DATABASE_URL=postgresql+asyncpg://naka:naka@localhost:5432/naka

# --- Redis / ARQ ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
ANTHROPIC_API_KEY=

# --- Auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# --- App ---
ENVIRONMENT=development
DEFAULT_LOCALE=mr
